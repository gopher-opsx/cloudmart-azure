# Copy this file to terraform.tfvars and replace the example values.
# Never store passwords, tokens, or connection strings here.

name_suffix = "a1b2c3"
owner       = "course-operator"

# Microsoft Entra object ID for the signed-in course operator.
# Get it with:
# az ad signed-in-user show --query id -o tsv
publisher_object_id = "00000000-0000-0000-0000-000000000000"

# Lesson 40: replace with the current public IPv4 address of the administration workstation.
# Keep the populated terraform.tfvars file local and ignored by Git.
postgresql_admin_client_ipv4 = "203.0.113.10"
