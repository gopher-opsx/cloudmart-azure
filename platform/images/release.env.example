# Copy to platform/images/release.env and replace values during Section 5.
# The populated release.env is intentionally ignored by Git.

ACR_NAME="<your-acr-name>"
CLOUDMART_ACR_LOGIN_SERVER="<your-acr-name>.azurecr.io"
CLOUDMART_IMAGE_VERSION="1.0.0"
CLOUDMART_GIT_SHA="<full-git-sha>"
CLOUDMART_SHA_TAG="sha-<12-character-sha>"
